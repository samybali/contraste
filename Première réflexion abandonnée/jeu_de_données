    "Girafe": 500, "Souris": 10, "Loup": 85, "Ours": 250, "Serpent": 150,
    "Kangourou": 140, "Lion": 120, "Tigre": 110, "Panda": 90, "Dauphin": 200,
    "Crocodile": 400, "Zèbre": 135, "Autruche": 210, "Chameau": 220, "Hippopotame": 150,
    "Rhinocéros": 170, "Koala": 70, "Lémurien": 45, "Baleine Bleue": 2500, "Requin Blanc": 600,
    "Aigle": 90, "Hérisson": 20, "Tortue": 50, "Pieuvre": 80, "Loutre": 75,
