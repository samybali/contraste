    "Pingouin": 65, "Écureuil": 30, "Canard": 50, "Lama": 140, "Tatou": 75
}
def contraste_michelson(x, y):
    if x==y:
        return 0
    else: return abs(x - y) / (x + y )  

    
def clustering_contraste_michelson(data, seuil_contraste):
    """Clustering hiérarchique incrémental basé sur le contraste de Michelson."""
    clusters = []  # Liste des clusters (chaque cluster est représenté par son centre)
    cluster_animaux = []  # Liste associant les animaux aux clusters

    for animal, taille in data.items():
        meilleur_contraste = float('inf')
        meilleur_cluster = None

        # Trouver le cluster avec le plus faible contraste
        for i, centre in enumerate(clusters):
            contraste = contraste_michelson(taille, centre)
            if contraste < meilleur_contraste:
                meilleur_contraste = contraste
                meilleur_cluster = i
        
        # Vérifier si on peut ajouter l'animal à un cluster existant
        if meilleur_contraste < seuil_contraste:
            # Mettre à jour le centre du cluster (moyenne simple)
            clusters[meilleur_cluster] = (clusters[meilleur_cluster] + taille) / 2
            cluster_animaux[meilleur_cluster].append(animal)
        else:
            # Créer un nouveau cluster avec la taille de l'animal comme centre
            clusters.append(taille)
            cluster_animaux.append([animal])
    
    return clusters, cluster_animaux


